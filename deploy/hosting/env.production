# =============================================================================
# KTNB App — Cấu hình PRODUCTION (hosting)
# Cách dùng: copy file này vào thư mục gốc project, đổi tên thành `.env`
# Điền các giá trị YOUR_* trước khi chạy artisan migrate.
# =============================================================================

APP_NAME="Trường Đại học Nguyễn Tất Thành- Phòng Kiểm tra Nội bộ"
APP_ENV=production
APP_KEY=YOUR_APP_KEY
APP_DEBUG=false
APP_URL=https://kiemtranoibo-ccks.ntt.edu.vn
APP_TIMEZONE=Asia/Ho_Chi_Minh

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- MySQL (thông tin hosting cấp) ---
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=YOUR_DB_NAME
DB_USERNAME=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=YOUR_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=YOUR_SMTP_USER
MAIL_PASSWORD=YOUR_SMTP_PASSWORD
MAIL_FROM_ADDRESS="no-reply@ntt.edu.vn"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Bảo mật API (đổi chuỗi mạnh, không dùng mặc định) ---
EXTERNAL_API_KEY=YOUR_STRONG_RANDOM_API_KEY

# --- Cổng Check-in Giảng viên (/lecturer-portal) ---
# Google Cloud Console → OAuth 2.0 → Authorized JavaScript origins: https://kiemtranoibo-ccks.ntt.edu.vn
GOOGLE_CLIENT_ID=
LECTURER_PORTAL_EMAIL_DOMAINS=nttu.edu.vn,ntt.edu.vn,gmail.com

# --- AI: quét giấy tờ, trợ lý AI (tùy chọn) ---
GOOGLE_GENAI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.0-flash

# --- Google Sheets (tùy chọn — bỏ trống = dùng mặc định trong config/nttu.php) ---
# SUMMARY_REPORT_GOOGLE_SHEET_ID=
# FEEDBACK_GOOGLE_SHEET_ID=
# FEEDBACK_GOOGLE_DRIVE_FOLDER_ID=

# --- Tài khoản admin / đăng nhập mặc định (nên đổi trên production) ---
# SUPER_ADMIN_DEFAULT_PASSWORD=
# SUPER_ADMIN_BOOTSTRAP_PASSWORD=
# SUPER_ADMIN_BOOTSTRAP_EMAILS=
# LOGIN_DEFAULT_EMAIL=
# LOGIN_DEFAULT_PASSWORD=

# --- Firebase import legacy (tùy chọn) ---
# FIREBASE_EMAIL=
# FIREBASE_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
